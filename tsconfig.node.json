{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*",
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/status.ts",
    "src/renderer/src/format.ts",
    "src/renderer/src/commsFilter.ts",
    "src/renderer/src/commsExport.ts",
    "src/renderer/src/briefHistory.ts",
    "src/renderer/src/tasks.ts",
    "vitest.config.ts",
    "test/**/*"
  ]
}
