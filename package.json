{
  "name": "vandelay-agents",
  "version": "0.2.0",
  "private": true,
  "description": "Vandelay Agents: run terminal coding CLIs as a team of agents on a 2D office floor.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryanthakur0505/vandelay-agents.git"
  },
  "homepage": "https://github.com/aryanthakur0505/vandelay-agents#readme",
  "bugs": "https://github.com/aryanthakur0505/vandelay-agents/issues",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "author": "Vandelay Agents contributors"
}
