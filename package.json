{
  "name": "vandelay-agents",
  "version": "0.4.0",
  "private": true,
  "description": "Vandelay Agents: run terminal coding CLIs as a team of agents on a 2D office floor.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "multi-agent",
    "electron",
    "terminal",
    "orchestrator",
    "xterm",
    "node-pty"
  ],
  "main": "./out/main/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryanthakur0505/vandelay-agents.git"
  },
  "homepage": "https://github.com/aryanthakur0505/vandelay-agents#readme",
  "bugs": "https://github.com/aryanthakur0505/vandelay-agents/issues",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "~6.8.12",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "~17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "~8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "author": "Vandelay Agents contributors"
}
